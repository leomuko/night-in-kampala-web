{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "functions": [{ "source": "functions", "codebase": "local-foundations", "runtime": "nodejs24", "predeploy": ["node \"$PROJECT_DIR/scripts/prepare-deployment.mjs\""] }],
  "hosting": {
    "predeploy": ["node \"$PROJECT_DIR/scripts/prepare-deployment.mjs\""],
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/@(index.html|favicon.svg|asset-provenance.json|shop|collections|archive|about|lookbooks|events|contact|cart|checkout|admin)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/@(help|orders|admin)/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/@(assets|share)/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "/fonts/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "/assets/**/*-????????.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ],
    "rewrites": [
      { "source": "/products/**", "function": { "functionId": "renderSharedLink", "region": "us-central1" } },
      { "source": "/collections/**", "function": { "functionId": "renderSharedLink", "region": "us-central1" } },
      { "source": "/events/**", "function": { "functionId": "renderSharedLink", "region": "us-central1" } },
      { "source": "/lookbooks/**", "function": { "functionId": "renderSharedLink", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "hosting": { "host": "127.0.0.1", "port": 5500 },
    "hub": { "host": "127.0.0.1", "port": 4400 },
    "logging": { "host": "127.0.0.1", "port": 4500 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 },
    "singleProjectMode": true
  }
}
