# Copy to .env.development.local for local overrides; do not use .env.local
# for emulator-only flags, because Vite loads it in production builds too.
# Unset defaults: demo emulators in development; offline preview in built files.
# VITE_USE_EMULATORS=true

# Cloud service getters can be opted into locally with false, after service setup.
# VITE_USE_EMULATORS=false
# Cloud access also requires BOTH an explicit target and its complete public config.
# VITE_FIREBASE_TARGET=staging
# VITE_FIREBASE_CONFIG={"apiKey":"...","projectId":"...","authDomain":"...","storageBucket":"...","appId":"...","messagingSenderId":"..."}
# Staging must use a separate project, never the protected night-in-kampala project.
# Use .env.staging.local / .env.production.local for the corresponding cloud build.

# Set only after the explicit region decision. No cloud default is selected.
# VITE_FIREBASE_FUNCTIONS_REGION=

# Analytics stays off unless enabled AND consent is explicitly granted in code.
VITE_ENABLE_ANALYTICS=false
