{
  "name": "night-in-kampala-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "workspaces": ["functions"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prepare-preview-template.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:metadata": "node --test functions/test/shared-links.test.js",
    "assets": "node scripts/prepare-assets.mjs",
    "emulators": "node scripts/emulators.mjs start",
    "emulators:seed": "node scripts/seed-emulators.mjs",
    "test:rules": "node scripts/emulators.mjs test"
  },
  "overrides": { "@grpc/grpc-js": "1.14.7" },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@fontsource/anton": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-admin": "14.5.1",
    "firebase-tools": "15.36.0",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "sharp": "0.35.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
