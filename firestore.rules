rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.get('owner', false) == true;
    }
    function isCatalogueStaff() {
      return isOwner() || (request.auth != null && request.auth.token.get('staff', false) == true);
    }

    match /products/{slug} {
      allow get: if resource.data.status == 'published';
      allow list: if resource.data.status == 'published' && request.query.limit <= 24;
    }
    match /productDrafts/{slug} {
      allow read: if isCatalogueStaff();
    }
    match /inventory/{slug} {
      allow get: if isCatalogueStaff();
    }
    match /auditLogs/{entry} {
      allow read: if isOwner();
    }
    match /catalogueSizes/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 24;
    }
    match /catalogueSettings/categories {
      allow get: if true;
    }

    match /contentDrafts/{id} {
      allow read: if isCatalogueStaff();
    }
    match /{collection}/{slug} {
      function isPublishedContent() {
        return collection in ['collections', 'events', 'lookbooks', 'pages'] && resource.data.status == 'published';
      }
      allow get: if isPublishedContent();
      allow list: if isPublishedContent() && request.query.limit <= 24;
    }
    match /orders/{id} {
      allow get: if isCatalogueStaff();
    }
    match /orderQueue/{id} {
      allow get: if isCatalogueStaff();
      allow list: if isCatalogueStaff() && request.query.limit <= 100;
    }
    match /orderSettings/config {
      allow get: if isCatalogueStaff();
    }
    match /orderPolicy/current {
      allow get: if true;
    }
    // All Firestore writes go through a trusted server. Orders remain private.
    match /{document=**} { allow read, write: if false; }
  }
}
